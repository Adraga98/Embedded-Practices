#include "fsl_debug_console.h"
#if defined(FSL_FEATURE_SOC_PORT_COUNT) && (FSL_FEATURE_SOC_PORT_COUNT)
#include "fsl_port.h"
#endif
#include "fsl_gpio.h"
#include "fsl_common.h"
#include "app.h"
#include "pin_mux.h"
#include "board.h"
/*******************************************************************************
 * Definitions
 ******************************************************************************/
typedef enum{
	STATE_RESET,
	STATE_BLUE,
	STATE_GREEN,
	STATE_RED,
	STATE_PURPLE,
	STATE_CYAN,
	STATE_WHITE,
	STATES_TOTAL
}state_t;

typedef state_t (*ptr_state)(void);
/*******************************************************************************
 * Prototypes
 ******************************************************************************/
state_t state_RESET(void);
state_t state_BLUE(void);
state_t state_GREEN(void);
state_t state_RED(void);
state_t state_PURPLE(void);
state_t state_CYAN(void);
state_t state_WHITE(void);

/*******************************************************************************
 * Variables
 ******************************************************************************/
ptr_state stateTable[STATES_TOTAL] = {
	state_RESET,
	state_BLUE,
	state_GREEN,
	state_RED,
	state_PURPLE,
	state_CYAN,
	state_WHITE
};

state_t currentState  = STATE_RESET;
/* Whether the SW button is pressed */
volatile bool g_Button_A = false;
volatile bool g_Button_B = false;
bool flag = false;

/*******************************************************************************
 * Code
 ******************************************************************************/
/*!
 * @brief Interrupt service fuction of switch.
 *
 * This function toggles the LED
 */
void BOARD_SW_IRQ_HANDLER(void)
{
#if (defined(FSL_FEATURE_PORT_HAS_NO_INTERRUPT) && FSL_FEATURE_PORT_HAS_NO_INTERRUPT) || \
    (!defined(FSL_FEATURE_SOC_PORT_COUNT))
    /* Clear external interrupt flag. */
    GPIO_GpioClearInterruptFlags(BOARD_SW_GPIO, 1U << BOARD_SW_GPIO_PIN);
#else
    /* Clear external interrupt flag. */
    GPIO_PortClearInterruptFlags(BOARD_SW_GPIO, 1U << BOARD_SW_GPIO_PIN);
#endif
    /* Change state of button. */
    g_Button_A = true;
    SDK_ISR_EXIT_BARRIER;
}

void BOARD_SW03_IRQ_HANDLER(void)
{
#if (defined(FSL_FEATURE_PORT_HAS_NO_INTERRUPT) && FSL_FEATURE_PORT_HAS_NO_INTERRUPT) || \
    (!defined(FSL_FEATURE_SOC_PORT_COUNT))
    /* Clear external interrupt flag. */
    GPIO_GpioClearInterruptFlags(BOARD_SW_03, 1U << BOARD_SW_03_PIN);
#else
    /* Clear external interrupt flag. */
    GPIO_PortClearInterruptFlags(BOARD_SW_03, 1U << BOARD_SW_03_PIN);
#endif
    /* Change state of button. */
    g_Button_B = true;
    SDK_ISR_EXIT_BARRIER;
}

/*!
 * @brief Main function
 */
int main(void)
{
    /* Define the init structure for the input switch pin */
    gpio_pin_config_t sw_config = {
        kGPIO_DigitalInput,
        0,
    };

    /* Define the init structure for the output LED pin */
    gpio_pin_config_t led_config = {
        kGPIO_DigitalOutput,
        1, //LED apagado
    };

    BOARD_InitHardware();

    /* Print a note to terminal. */
    PRINTF("\r\n GPIO Driver example\r\n");
    PRINTF("\r\n Press %s to turn on/off a LED \r\n", BOARD_SW_NAME);

/* Init input switch GPIO. */
#if (defined(FSL_FEATURE_PORT_HAS_NO_INTERRUPT) && FSL_FEATURE_PORT_HAS_NO_INTERRUPT) || \
    (!defined(FSL_FEATURE_SOC_PORT_COUNT))
    GPIO_SetPinInterruptConfig(BOARD_SW_GPIO, BOARD_SW_GPIO_PIN, kGPIO_InterruptFallingEdge);
    GPIO_SetPinInterruptConfig(BOARD_SW_03, BOARD_SW_03_PIN, kGPIO_InterruptFallingEdge);
#else
    PORT_SetPinInterruptConfig(BOARD_SW_PORT, BOARD_SW_GPIO_PIN, kPORT_InterruptFallingEdge);
#endif
    EnableIRQ(BOARD_SW_IRQ);
    EnableIRQ(BOARD_SW03_IRQ);

    GPIO_PinInit(BOARD_SW_GPIO, BOARD_SW_GPIO_PIN, &sw_config);
    GPIO_PinInit(BOARD_SW_03, BOARD_SW_03_PIN, &sw_config);

    /* Init output LED GPIO. */
    GPIO_PinInit(BOARD_LED_GPIO , BOARD_LED_BLUE_PIN, &led_config);
    GPIO_PinInit(BOARD_LED_GPIO , BOARD_LED_GREEN_PIN, &led_config);
    GPIO_PinInit(BOARD_LED_GPIO , BOARD_LED_RED_PIN, &led_config);

    while (1)
    {
        //if ((g_Button_A || g_Button_B) && flag)
        if (g_Button_A)
        {
        	if (currentState < (STATES_TOTAL-1)){

        		currentState = stateTable[currentState+1]();
        	}
        	else{
        		currentState = STATE_RESET;
        		currentState = stateTable[currentState]();
        	}
        	g_Button_A = false;
        }
        if( g_Button_B){

        	if (currentState > (STATE_RESET)){

        		currentState = stateTable[currentState--]();
        	}
        	else{
        		currentState = STATE_WHITE;
        		currentState = stateTable[currentState--]();
        	}
        	g_Button_B = false;
        }
        /*if(flag == false){
        	currentState = stateTable[STATE_RESET]();
        	flag = true;
        }*/

    }
}

state_t state_RESET(void){

	state_t curr_State = STATE_RESET;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 1);

	return curr_State;
}

state_t state_BLUE(void){
	state_t curr_State = STATE_BLUE;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 1);

	return curr_State;
}

state_t state_GREEN(void){
	state_t curr_State = STATE_GREEN;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 0);

	return curr_State;
}

state_t state_RED(void){
	state_t curr_State = STATE_RED;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 1);

	return curr_State;
}

state_t state_CYAN(void){
	state_t curr_State = STATE_CYAN;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 1);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 0);

	return curr_State;
}

state_t state_PURPLE(void){
	state_t curr_State = STATE_PURPLE;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 1);

	return curr_State;
}

state_t state_WHITE(void){
	state_t curr_State = STATE_WHITE;
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_RED_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_BLUE_GPIO_PIN, 0);
	GPIO_PinWrite(BOARD_LED_GPIO, BOARD_LED_GREEN_GPIO_PIN, 0);

	return curr_State;
}

